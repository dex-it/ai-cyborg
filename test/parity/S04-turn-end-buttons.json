{
  "id": "S04",
  "title": "Кнопки конца хода",
  "baseline": "e4beb72",
  "kind": "recorded",
  "about": "Хук Stop с хвостом <!-- cyborg-buttons: [...] --> даёт session:suggest: на полосе кнопки с ✦, не больше двух, реплика с «!» отброшена. «Отправь» шлёт текст с Enter, «Вставь» - без.",
  "volatile": [
    "invoke git:status",
    "invoke git:branch"
  ],
  "steps": [
    {
      "do": "key",
      "key": "N",
      "code": "KeyN",
      "vk": 78,
      "mods": [
        "cmd",
        "shift"
      ]
    },
    {
      "do": "wait",
      "what": "вкладок не меньше 1",
      "js": "document.querySelectorAll('#session-list > *').length >= 1"
    },
    {
      "do": "wait",
      "what": "в терминале «fake-claude ready»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"fake-claudeready\"))"
    },
    {
      "do": "input",
      "session": 1,
      "text": "suggest\r"
    },
    {
      "do": "waitTrace",
      "channel": "session:suggest",
      "what": "session:suggest"
    },
    {
      "do": "wait",
      "what": "кнопки ✦ на полосе",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].some((b) => b.firstChild.textContent === '✦ Вставь')"
    },
    {
      "do": "probe",
      "name": "кнопки",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].map((b) => b.firstChild.textContent)"
    },
    {
      "do": "js",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].find((b) => b.firstChild.textContent === '✦ Отправь').click()"
    },
    {
      "do": "wait",
      "what": "в терминале «got: [отправь это]»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"got:[\\u043e\\u0442\\u043f\\u0440\\u0430\\u0432\\u044c\\u044d\\u0442\\u043e]\"))"
    },
    {
      "do": "js",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].find((b) => b.firstChild.textContent === '✦ Вставь').click()"
    },
    {
      "do": "wait",
      "what": "в терминале «вставь это»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"\\u0432\\u0441\\u0442\\u0430\\u0432\\u044c\\u044d\\u0442\\u043e\"))"
    },
    {
      "do": "probe",
      "name": "кнопки после",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].map((b) => b.firstChild.textContent)"
    }
  ],
