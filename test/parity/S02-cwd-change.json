  "about": "Хук PostToolUse(EnterWorktree) пишет новый cwd в файл событий сессии: главный процесс шлёт session:cwd, дерево переходит в worktree.",
  "steps": [
    {
      "do": "key",
      "key": "N",
      "code": "KeyN",
      "vk": 78,
      "mods": [
        "cmd",
        "shift"
      ]
    },
    {
      "do": "wait",
      "what": "вкладок не меньше 1",
      "js": "document.querySelectorAll('#session-list > *').length >= 1"
    },
    {
      "do": "wait",
      "what": "в терминале «fake-claude ready»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"fake-claudeready\"))"
    },
    {
      "do": "input",
      "session": 1,
      "text": "cd {worktree}\r"
    },
    {
      "do": "waitTrace",
      "channel": "session:cwd",
      "what": "session:cwd"
    },
    {
      "do": "wait",
      "what": "дерево в worktree",
      "js": "document.querySelector('#tree-meta').innerText.includes('repo-wt')"
    },
    {
      "do": "probe",
      "name": "мета дерева",
      "js": "document.querySelector('#tree-meta').innerText"
    }
  ],
