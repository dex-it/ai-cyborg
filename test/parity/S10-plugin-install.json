{
  "id": "S10",
  "title": "Установка плагина Claude Code",
  "baseline": "e4beb72",
  "kind": "recorded",
  "about": "Окно «Расширения» -> «Магазины»: фильтр находит удалённый плагин, форма установки (область local по умолчанию), submit зовёт claude plugin install <плагин>@<магазин> --scope local --json без подтверждения чужих команд.",
  "steps": [
    {
      "do": "menu",
      "menu": "Расширения",
      "item": "Магазины…"
    },
    {
      "do": "wait",
      "what": "магазин виден",
      "js": "[...document.querySelectorAll('#ext-tree [role=treeitem] .ext-label')].some((l) => l.textContent === \"smoke-market\")"
    },
    {
      "do": "js",
      "js": "(() => { const f = document.querySelector(\"#ext-filter\"); f.value = \"smk-remote\"; f.dispatchEvent(new Event('input')); })()"
    },
    {
      "do": "wait",
      "what": "удалённый плагин найден",
      "js": "[...document.querySelectorAll('#ext-tree [role=treeitem] .ext-label')].some((l) => l.textContent === \"smk-remote\")"
    },
    {
      "do": "wait",
      "what": "кнопка установки",
      "js": "(() => { const r = [...document.querySelectorAll('#ext-tree [role=treeitem]')].find((x) => x.querySelector('.ext-label')?.textContent === \"smk-remote\"); const b = r && [...r.querySelectorAll('button')].find((x) => x.textContent === \"\\u0423\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u0438\\u0442\\u044c\\u2026\"); if (b) b.click(); return !!b; })()"
    },
    {
      "do": "wait",
      "what": "форма установки",
      "js": "!document.querySelector('#ext-action').hidden && /smk-remote@smoke-market/.test(document.querySelector('#ext-action-title').innerText)"
    },
    {
      "do": "probe",
      "name": "область",
      "js": "document.querySelector('#ext-action-scope').value"
    },
    {
      "do": "js",
      "js": "document.querySelector('#ext-action').requestSubmit()"
    },
    {
      "do": "wait",
      "what": "установка выполнена",
      "js": "/Готово: smk-remote@smoke-market/.test(document.querySelector('#ext-action-result').innerText)"
    }
  ],
