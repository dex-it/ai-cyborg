      "do": "js",
      "js": "document.querySelector(\"#side-history\").click()"
    },
    {
      "do": "wait",
      "what": "запись истории",
      "js": "document.querySelectorAll('#history .history-item').length === 1"
    },
    {
      "do": "probe",
      "name": "запись",
      "js": "document.querySelector('#history .history-item .history-title').textContent"
