    {
      "do": "js",
      "js": "document.querySelector(\"#history .history-item\").click()"
    },
    {
      "do": "wait",
      "what": "вкладок не меньше 1",
      "js": "document.querySelectorAll('#session-list > *').length >= 1"
    },
    {
      "do": "wait",
      "what": "в терминале «--resume 0b1f6c4e-2d3a-4b5c-8d7e-9f0a1b2c3d4e»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"--resume0b1f6c4e-2d3a-4b5c-8d7e-9f0a1b2c3d4e\"))"
    },
    {
      "do": "js",
      "js": "document.querySelector(\"#side-history\").click()"
    },
    {
      "do": "wait",
      "what": "запись истории после возврата",
      "js": "document.querySelectorAll('#history .history-item').length === 1"
    },
    {
      "do": "js",
      "js": "document.querySelector(\"#history .history-item .close\").click()"
    },
    {
      "do": "wait",
      "what": "запись удалена",
      "js": "document.querySelectorAll('#history .history-item').length === 0"
    },
    {
      "do": "probe",
      "name": "журнал стёрт",
      "js": "document.querySelector('#history').innerText"
    }
  ],
