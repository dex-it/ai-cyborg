{
  "id": "S06",
  "title": "Старт сессии по задаче",
  "baseline": "e4beb72",
  "kind": "recorded",
  "about": "Панель «Задачи» берёт открытые задачи GitHub через gh (подставной, FAKE_GH=data), «Начать» создаёт сессию с намерением {task} и промптом из ссылки; в аргументы claude попадают ссылка и команда gh, а не название и автор.",
  "world": {
    "gh": "data"
  },
  "steps": [
    {
      "do": "js",
      "js": "document.querySelector(\"#tasks-toggle\").click()"
    },
    {
      "do": "wait",
      "what": "три задачи в панели",
      "js": "document.querySelectorAll('#tasks-panel .task-row').length >= 3"
    },
    {
      "do": "probe",
      "name": "строки",
      "js": "[...document.querySelectorAll('#tasks-panel .task-row .task-title')].map((e) => e.textContent)"
    },
    {
      "do": "js",
      "js": "[...document.querySelectorAll('#tasks-panel .task-row button')].find((b) => b.textContent === 'Начать').click()"
    },
    {
      "do": "wait",
      "what": "вкладок не меньше 1",
      "js": "document.querySelectorAll('#session-list > *').length >= 1"
    },
    {
      "do": "waitTrace",
      "channel": "session:activity",
      "what": "claude стартовал (SessionStart)"
    },
    {
      "do": "probe",
      "name": "вкладок",
      "js": "document.querySelectorAll('#session-list > *').length"
    }
  ],
