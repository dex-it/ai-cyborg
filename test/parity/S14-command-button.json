{
  "id": "S14",
  "title": "Кнопка-команда",
  "baseline": "e4beb72",
  "kind": "recorded",
  "about": "Встроенная «Сливай» шлёт текст с Enter; набор из воркспейса (commands:save) добавляет кнопку с подстановкой {branch}, нажатие шлёт «ветка main».",
  "steps": [
    {
      "do": "key",
      "key": "N",
      "code": "KeyN",
      "vk": 78,
      "mods": [
        "cmd",
        "shift"
      ]
    },
    {
      "do": "wait",
      "what": "вкладок не меньше 1",
      "js": "document.querySelectorAll('#session-list > *').length >= 1"
    },
    {
      "do": "wait",
      "what": "в терминале «fake-claude ready»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"fake-claudeready\"))"
    },
    {
      "do": "probe",
      "name": "кнопки",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].map((b) => b.firstChild.textContent)"
    },
    {
      "do": "js",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].find((b) => b.firstChild.textContent === 'Сливай').click()"
    },
    {
      "do": "wait",
      "what": "в терминале «got: [сливай]»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"got:[\\u0441\\u043b\\u0438\\u0432\\u0430\\u0439]\"))"
    },
    {
      "do": "call",
      "method": "saveCommands",
      "args": [
        "[{\"label\": \"Приберись\"}, {\"label\": \"Сливай\"}, {\"label\": \"Ветка\", \"text\": \"ветка {branch}\", \"submit\": true}]",
        "workspace"
      ],
      "as": "сохранение кнопок"
    },
    {
      "do": "js",
      "js": "window.dispatchEvent(new Event('focus'))"
    },
    {
      "do": "wait",
      "what": "кнопка из воркспейса",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].some((b) => b.firstChild.textContent === 'Ветка')"
    },
    {
      "do": "js",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].find((b) => b.firstChild.textContent === 'Ветка').click()"
    },
    {
      "do": "wait",
      "what": "в терминале «got: [ветка main]»",
      "js": "[...document.querySelectorAll('.xterm-rows')].some((e) => e.offsetParent && e.textContent.replace(/\\s+/g, '').includes(\"got:[\\u0432\\u0435\\u0442\\u043a\\u0430main]\"))"
    },
    {
      "do": "probe",
      "name": "кнопки после",
      "js": "[...document.querySelectorAll('.workspace-pane.active .command-button')].map((b) => b.firstChild.textContent)"
    }
  ],
