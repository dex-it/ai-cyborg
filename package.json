{
  "name": "cyborg",
  "version": "0.1.0",
  "private": true,
  "description": "Рабочее место для нативных сессий Claude Code: дерево файлов сессии, git-изменения, просмотр файлов",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
